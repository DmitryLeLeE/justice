---
import '@fontsource/libre-baskerville/400.css';
import '@fontsource/libre-baskerville/400-italic.css';
import '@fontsource/libre-baskerville/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';
import { url } from '../lib/cases';

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL of a picture for link previews; left out for 18+ files. */
  image?: string;
  imageAlt?: string;
}

const siteName = 'Atlas of Justice';
const {
  title,
  description = 'A map of famous trials around the world: courtroom drawings and case photographs, short case files and sources.',
  image,
  imageAlt,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = title ? `${title} · ${siteName}` : siteName;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf8f4" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta property="og:image:alt" content={imageAlt ?? pageTitle} />}
    {image && <meta name="twitter:image" content={image} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      // Decide the edition before first paint so restricted content never flashes
      try { document.documentElement.dataset.adult = localStorage.getItem('aj-adult') === '1' ? '1' : '0'; }
      catch (e) { document.documentElement.dataset.adult = '0'; }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the content</a>
    <header class="site-header">
      <a class="brand" href={url()}>
        <span>Atlas of Justice</span>
      </a>
      <nav aria-label="Main navigation">
        <a href={url()}>Map</a>
        <a href={url('#categories')}>Categories</a>
        <a href={url('about/')}>About</a>
        <button type="button" id="adult-toggle" class="adult-toggle" aria-pressed="false" title="Switch the 18+ edition on or off">
          <span class="at-badge">18+</span><span class="at-state">off</span>
        </button>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <dialog id="age-gate" class="age-gate" aria-labelledby="age-gate-h">
      <form method="dialog">
        <p class="ag-badge">18+</p>
        <h2 id="age-gate-h">Restricted edition</h2>
        <p>
          The 18+ edition adds cases and sections that describe killings, torture, sexual violence and other
          crimes in plain, factual language, taken from court records and reliable reporting. There are no
          crime-scene or victim photographs, but the text is not softened.
        </p>
        <p>Continue only if you are 18 or older.</p>
        <div class="ag-actions">
          <button value="yes" class="ag-yes" id="age-yes">I am 18 or older</button>
          <button value="no" class="ag-no">Stay in the standard edition</button>
        </div>
      </form>
    </dialog>
    <footer class="site-footer">
      <p>Atlas of Justice. Case files are compiled from public sources, linked on each page. Every picture is credited to its author or archive. Outcome labels give the final legal result described in each case.</p>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('adult-toggle');
        var gate = document.getElementById('age-gate');
        function render() {
          var on = root.dataset.adult === '1';
          btn.setAttribute('aria-pressed', on ? 'true' : 'false');
          btn.querySelector('.at-state').textContent = on ? 'on' : 'off';
        }
        function set(on) {
          try { localStorage.setItem('aj-adult', on ? '1' : '0'); } catch (e) {}
          root.dataset.adult = on ? '1' : '0';
          render();
          document.dispatchEvent(new CustomEvent('adultchange', { detail: on }));
        }
        function ask() {
          if (gate && gate.showModal) { gate.showModal(); }
          else if (window.confirm('The 18+ edition contains frank descriptions of violence. Are you 18 or older?')) { set(true); }
        }
        window.ajAskAdult = ask;
        btn.addEventListener('click', function () { if (root.dataset.adult === '1') set(false); else ask(); });
        if (gate) gate.addEventListener('close', function () { if (gate.returnValue === 'yes') set(true); gate.returnValue = ''; });
        render();
      })();
    </script>
  </body>
</html>
