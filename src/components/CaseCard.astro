---
import type { CaseEntry } from '../lib/cases';
import { imgSrc, url, yearsLabel, decadeOf } from '../lib/cases';
import { CATEGORIES, VERDICTS } from '../lib/taxonomy';

interface Props {
  entry: CaseEntry;
  number: number;
}

const { entry, number } = Astro.props;
const d = entry.data;
const fileNo = String(number).padStart(3, '0');
const verdict = d.verdict ? VERDICTS[d.verdict] : null;
const search = `${d.title} ${d.titleOriginal ?? ''} ${d.country} ${d.city} ${d.court} ${d.summary}`.toLowerCase();
---

<article
  class="card"
  data-id={entry.id}
  data-region={d.region}
  data-category={d.category}
  data-decade={decadeOf(d.yearStart)}
  data-mature={d.mature ? '1' : '0'}
  data-search={search}
>
  <a class="card-link" href={url(`cases/${entry.id}/`)}>
    <div class="thumb">
      <span class="file-no">AJ-{fileNo}</span>
      {d.mature && <span class="adult-chip">18+</span>}
      <img src={imgSrc(d.image!.src)} alt={d.image!.alt} loading="lazy" referrerpolicy="no-referrer" />
      {verdict && <span class={`verdict-stamp tone-${verdict.tone}`}>{verdict.label}</span>}
    </div>
    <p class="meta">{d.city}, {d.country} · {yearsLabel(d)}</p>
    <h3>{d.title}</h3>
    <p class="summary">{d.summary}</p>
  </a>
  <div class="card-foot">
    <a class="tag" href={url(`category/${d.category}/`)}>{CATEGORIES[d.category].label}</a>
    <button type="button" class="show-on-map" data-focus={entry.id}>Locate</button>
  </div>
</article>
