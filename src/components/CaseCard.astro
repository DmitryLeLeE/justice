---
import type { CaseEntry } from '../lib/cases';
import { url, yearsLabel } from '../lib/cases';
import { REGIONS, CATEGORIES } from '../lib/taxonomy';

interface Props {
  entry: CaseEntry;
}

const { entry } = Astro.props;
const d = entry.data;
---

<article
  class="card"
  data-id={entry.id}
  data-region={d.region}
  data-category={d.category}
>
  <a class="card-link" href={url(`cases/${entry.id}/`)}>
    <div class="thumb">
      {
        d.image ? (
          <img src={url(d.image.src)} alt={d.image.alt} loading="lazy" />
        ) : (
          <div class="placeholder" role="img" aria-label="Рисунок из зала суда пока не добавлен">
            <span>рисунок готовится</span>
          </div>
        )
      }
    </div>
    <p class="meta">{d.country} · {yearsLabel(d)}</p>
    <h3>{d.title}</h3>
    <p class="summary">{d.summary}</p>
  </a>
  <div class="card-foot">
    <span class="tag">{CATEGORIES[d.category]}</span>
    <button type="button" class="show-on-map" data-focus={entry.id}>
      На карте
    </button>
  </div>
</article>
