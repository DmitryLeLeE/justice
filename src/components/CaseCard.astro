---
import type { CaseEntry } from '../lib/cases';
import { imgSrc, yearsLabel } from '../lib/cases';
import { CATEGORIES } from '../lib/taxonomy';

interface Props {
  entry: CaseEntry;
  number: number;
}

const { entry, number } = Astro.props;
const d = entry.data;
const fileNo = String(number).padStart(3, '0');
---

<article
  class="card"
  data-id={entry.id}
  data-region={d.region}
  data-category={d.category}
  data-theme={d.theme}
>
  <a class="card-link" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/cases/${entry.id}/`}>
    <div class="thumb">
      <span class="file-no">FILE {fileNo}</span>
      {
        d.image ? (
          <img src={imgSrc(d.image.src)} alt={d.image.alt} loading="lazy" referrerpolicy="no-referrer" />
        ) : (
          <div class="placeholder" role="img" aria-label="No courtroom drawing has been added yet">
            <span>drawing not yet on file</span>
          </div>
        )
      }
    </div>
    <p class="meta">{d.country} · {yearsLabel(d)}</p>
    <h3>{d.title}</h3>
    <p class="summary">{d.summary}</p>
  </a>
  <div class="card-foot">
    <span class="tag">{CATEGORIES[d.category]}</span>
    <button type="button" class="show-on-map" data-focus={entry.id}>
      Locate
    </button>
  </div>
</article>
