---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getCases, url, yearsLabel } from '../../lib/cases';
import { REGIONS, CATEGORIES } from '../../lib/taxonomy';

export async function getStaticPaths() {
  const cases = await getCases();
  return cases.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: cases[i - 1] ?? null, next: cases[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<Base title={d.title} description={d.summary}>
  <article class="case">
    <p class="crumbs">
      <a href={url(`#${entry.id}`)}>← Показать на карте</a>
    </p>
    <h1>{d.title}</h1>
    {d.titleOriginal && <p class="orig">{d.titleOriginal}</p>}

    <figure>
      <div class={d.image ? 'frame' : 'frame is-empty'}>
        {
          d.image ? (
            <img src={url(d.image.src)} alt={d.image.alt} />
          ) : (
            <div class="hero-ph">Рисунок из зала суда пока не добавлен</div>
          )
        }
      </div>
      {
        d.image && (
          <figcaption>
            {d.image.caption && <>{d.image.caption}. </>}
            {d.image.artist && <>Художник: {d.image.artist}. </>}
            Лицензия: {d.image.license}. <a href={d.image.sourceUrl} rel="noopener">Источник</a>
          </figcaption>
        )
      }
    </figure>

    <dl class="facts">
      <dt>Страна</dt><dd>{d.country}</dd>
      <dt>Город</dt><dd>{d.city}</dd>
      <dt>Суд</dt><dd>{d.court}</dd>
      <dt>Годы</dt><dd>{yearsLabel(d)}</dd>
      <dt>Регион</dt><dd>{REGIONS[d.region]}</dd>
      <dt>Тип дела</dt><dd>{CATEGORIES[d.category]}</dd>
      <dt>Итог</dt><dd>{d.outcome}</dd>
    </dl>

    <div class="prose">
      <Content />
    </div>

    <section class="sources">
      <h2>Источники</h2>
      <ul>
        {d.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}
      </ul>
    </section>

    <nav class="pager" aria-label="Соседние дела">
      {prev && <a class="prev" href={url(`cases/${prev.id}/`)}>← {prev.data.title}</a>}
      {next && <a class="next" href={url(`cases/${next.id}/`)}>{next.data.title} →</a>}
    </nav>
  </article>
</Base>
