---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import { getCases, url, yearsLabel, decadeOf } from '../lib/cases';
import { REGIONS, CATEGORIES, categoryKeys } from '../lib/taxonomy';

const cases = await getCases();

// Only what the map needs. Text reaches the DOM via textContent, never innerHTML.
const points = cases.map((c) => ({
  id: c.id,
  title: c.data.title,
  place: `${c.data.city}, ${c.data.country}`,
  years: yearsLabel(c.data),
  summary: c.data.summary,
  lat: c.data.lat,
  lng: c.data.lng,
  region: c.data.region,
  category: c.data.category,
  decade: decadeOf(c.data.yearStart),
  search: `${c.data.title} ${c.data.titleOriginal ?? ''} ${c.data.country} ${c.data.city} ${c.data.court} ${c.data.summary}`.toLowerCase(),
  href: url(`cases/${c.id}/`),
  mature: !!c.data.mature,
}));
const safe = cases.filter((c) => !c.data.mature);

const countries = new Set(cases.map((c) => c.data.country)).size;
const countriesSafe = new Set(safe.map((c) => c.data.country)).size;
const years = cases.map((c) => c.data.yearStart);
const firstYear = Math.min(...years);
const lastYear = Math.max(...years);
const decades = [...new Set(years.map(decadeOf))].sort((a, b) => a - b);
const drawers = categoryKeys
  .map((k) => ({ key: k, n: cases.filter((c) => c.data.category === k).length, ns: safe.filter((c) => c.data.category === k).length }))
  .filter((d) => d.n > 0);
---

<Base>
  <section class="hero">
    <div class="hero-text">
      <p class="kicker">Case files from the world's courtrooms</p>
      <h1>Atlas of <span class="strike">Justice</span></h1>
      <p class="hero-lede">
        Trials, tribunals and hearings, each with a drawing made in the room. Pick a pin, open a file:
        who stood accused, what was said, how it ended.
      </p>
      <p class="hand-note hero-note" aria-hidden="true">no cameras allowed. only pencils.</p>
    </div>
    <dl class="stats" aria-label="The archive in numbers">
      <div><dt>Files</dt><dd><span class="only-safe">{safe.length}</span><span class="only-adult">{cases.length}</span></dd></div>
      <div><dt>Countries</dt><dd><span class="only-safe">{countriesSafe}</span><span class="only-adult">{countries}</span></dd></div>
      <div><dt>Drawers</dt><dd>{drawers.length}</dd></div>
      <div><dt>Span</dt><dd>{firstYear}–{lastYear}</dd></div>
    </dl>
  </section>

  <div class="map-wrap">
    <div id="map" role="region" aria-label="Map of trials"></div>
  </div>
  <p class="map-note">Pins mark a city, not a courthouse address.</p>

  <section id="drawers" class="drawers" aria-labelledby="drawers-h">
    <h2 id="drawers-h" class="sect-light">The filing drawers</h2>
    <ul>
      {
        drawers.map((d) => (
          <li>
            <a href={url(`category/${d.key}/`)}>
              <span class="drawer-no">{CATEGORIES[d.key].numeral}</span>
              <span class="drawer-name">{CATEGORIES[d.key].label}</span>
              <span class="drawer-count"><span class="only-safe">{d.ns}</span><span class="only-adult">{d.n}</span></span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <form class="filters" aria-label="Filters" onsubmit="return false">
    <label class="f-search">
      Search the archive
      <input type="search" id="f-q" placeholder="name, city, charge…" autocomplete="off" />
    </label>
    <label>
      Drawer
      <select id="f-category">
        <option value="">All drawers</option>
        {drawers.map((d) => <option value={d.key}>{CATEGORIES[d.key].label}</option>)}
      </select>
    </label>
    <label>
      Region
      <select id="f-region">
        <option value="">All regions</option>
        {Object.entries(REGIONS).filter(([k]) => cases.some((c) => c.data.region === k)).map(([k, v]) => <option value={k}>{v}</option>)}
      </select>
    </label>
    <label>
      Decade
      <select id="f-decade">
        <option value="">Any decade</option>
        {decades.map((dc) => <option value={dc}>{dc}s</option>)}
      </select>
    </label>
    <button type="button" id="f-reset">Reset</button>
    <button type="button" id="f-random" class="accent">Pull a random file</button>
    <p class="count" id="count" aria-live="polite">Files: {safe.length}</p>
  </form>

  <ul class="grid" id="grid" style="list-style:none">
    {cases.map((entry, i) => <li><CaseCard entry={entry} number={i + 1} /></li>)}
  </ul>
  <p class="empty" id="empty" hidden>No files match these filters.</p>

<script type="application/json" id="cases-data" set:html={JSON.stringify(points)} />

  <script>
    import L from 'leaflet';
    import 'leaflet/dist/leaflet.css';

    type Point = {
      id: string; title: string; place: string; years: string; summary: string;
      lat: number; lng: number; region: string; category: string; decade: number; search: string; href: string; mature: boolean;
    };

    const data: Point[] = JSON.parse(document.getElementById('cases-data')!.textContent || '[]');

    const map = L.map('map', { worldCopyJump: true, minZoom: 2, maxZoom: 10, scrollWheelZoom: false })
      .setView([25, 15], 2);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 10,
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    // The wheel zooms the map only after it has focus, so it does not hijack page scrolling
    map.on('focus', () => map.scrollWheelZoom.enable());
    map.on('blur', () => map.scrollWheelZoom.disable());

    function popupFor(p: Point): HTMLElement {
      const el = document.createElement('div');
      el.className = 'popup';
      const h = document.createElement('h3');
      h.textContent = p.title;
      const m = document.createElement('p');
      m.className = 'pm';
      m.textContent = `${p.place} · ${p.years}`;
      const s = document.createElement('p');
      s.textContent = p.summary;
      const a = document.createElement('a');
      a.href = p.href;
      a.textContent = 'Open the file';
      el.append(h, m, s, a);
      return el;
    }

    const markers = new Map<string, L.Marker>();
    for (const p of data) {
      const marker = L.marker([p.lat, p.lng], {
        icon: L.divIcon({ className: '', html: '<div class="pin"></div>', iconSize: [16, 16], iconAnchor: [8, 8] }),
        title: p.title,
        keyboard: true,
      }).bindPopup(popupFor(p), { maxWidth: 280 });
      marker.on('click', () => marker.openPopup());
      markers.set(p.id, marker);
    }

    const regionSel = document.getElementById('f-region') as HTMLSelectElement;
    const categorySel = document.getElementById('f-category') as HTMLSelectElement;
    const decadeSel = document.getElementById('f-decade') as HTMLSelectElement;
    const qInput = document.getElementById('f-q') as HTMLInputElement;
    const randomBtn = document.getElementById('f-random') as HTMLButtonElement;
    const resetBtn = document.getElementById('f-reset') as HTMLButtonElement;
    const countEl = document.getElementById('count')!;
    const emptyEl = document.getElementById('empty')!;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));

    function apply(fit = true) {
      const region = regionSel.value;
      const category = categorySel.value;
      const decade = decadeSel.value;
      const terms = qInput.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const visible: Point[] = [];
      const adult = document.documentElement.dataset.adult === '1';
      for (const p of data) {
        const ok =
          (adult || !p.mature) &&
          (!region || p.region === region) &&
          (!category || p.category === category) &&
          (!decade || String(p.decade) === decade) &&
          terms.every((t) => p.search.includes(t));
        const marker = markers.get(p.id)!;
        if (ok) { marker.addTo(map); visible.push(p); } else { marker.remove(); }
      }
      const ids = new Set(visible.map((p) => p.id));
      for (const c of cards) {
        const show = ids.has(c.dataset.id || '');
        c.hidden = !show;
        (c.parentElement as HTMLElement).hidden = !show;
      }
      countEl.textContent = `Files: ${visible.length}`;
      emptyEl.hidden = visible.length > 0;
      if (fit && visible.length) {
        map.fitBounds(L.latLngBounds(visible.map((p) => [p.lat, p.lng] as [number, number])), {
          padding: [50, 50], maxZoom: 5,
        });
      }
    }

    regionSel.addEventListener('change', () => apply());
    categorySel.addEventListener('change', () => apply());
    decadeSel.addEventListener('change', () => apply());
    qInput.addEventListener('input', () => apply(false));
    randomBtn.addEventListener('click', () => {
      const adult = document.documentElement.dataset.adult === '1';
      const pool = data.filter((p) => adult || !p.mature);
      const pick = pool[Math.floor(Math.random() * pool.length)];
      location.href = pick.href;
    });
    resetBtn.addEventListener('click', () => {
      regionSel.value = '';
      categorySel.value = '';
      decadeSel.value = '';
      qInput.value = '';
      apply();
      map.setView([25, 15], 2);
    });

    function focusCase(id: string) {
      const p = data.find((x) => x.id === id);
      const marker = markers.get(id);
      if (!p || !marker) return;
      if (!map.hasLayer(marker)) { regionSel.value = ''; categorySel.value = ''; decadeSel.value = ''; qInput.value = ''; apply(false); }
      if (!map.hasLayer(marker)) return;
      document.getElementById('map')!.scrollIntoView({ behavior: 'smooth', block: 'center' });
      map.flyTo([p.lat, p.lng], 5, { duration: 0.8 });
      marker.openPopup();
    }

    document.querySelectorAll<HTMLButtonElement>('.show-on-map').forEach((btn) => {
      btn.addEventListener('click', () => focusCase(btn.dataset.focus || ''));
    });

    document.addEventListener('adultchange', () => apply(false));
    apply(false);
    const hash = decodeURIComponent(location.hash.replace(/^#/, ''));
    if (hash) focusCase(hash);
  </script>
</Base>
